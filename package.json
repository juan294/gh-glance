{
  "name": "gh-glance",
  "version": "0.2.0",
  "description": "A live-refreshing GitHub dashboard for your terminal: Actions, Issues, Pull Requests, and Security alerts in one narrow pane",
  "type": "module",
  "bin": {
    "gh-glance": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "prepare": "husky || true",
    "prepublishOnly": "npm run lint && node --check index.mjs && npm test",
    "start": "node index.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "github",
    "github-actions",
    "cli",
    "tui",
    "terminal",
    "dashboard",
    "ink",
    "developer-tools"
  ],
  "author": "juan294",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/juan294/gh-glance.git"
  },
  "bugs": {
    "url": "https://github.com/juan294/gh-glance/issues"
  },
  "homepage": "https://github.com/juan294/gh-glance#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7"
  }
}
