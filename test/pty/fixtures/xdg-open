#!/bin/sh
# Stand-in for the platform browser opener (`open` on darwin, `xdg-open` on
# linux). Opening a row's page is a local action now -- it makes no GitHub
# request -- but it is still a child process, and quitting must abort it rather
# than wait for it. GH_GLANCE_FIXTURE_STALL_VIEW is what makes that testable.
: "${GH_GLANCE_FIXTURE_LOG:=/dev/null}"
echo "open $*" >> "$GH_GLANCE_FIXTURE_LOG"
if [ -f "${GH_GLANCE_FIXTURE_OPEN_FAILURE_FILE:-}" ]; then
  echo "fixture browser unavailable" >&2
  exit 1
fi
if [ -n "${GH_GLANCE_FIXTURE_STALL_VIEW:-}" ]; then
  exec sleep 30
fi
exit 0
