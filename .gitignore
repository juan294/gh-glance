# No trailing slash: a worktree often gets node_modules as a *symlink* to the
# main checkout's copy rather than a real directory, and `node_modules/` matches
# only a directory -- so the symlink was not ignored and could be committed.
node_modules
*.log
*.tgz
.DS_Store
.env
.env.*
.vscode/
.worktrees/
.claude/worktrees/
CLAUDE.local.md
.claude/settings.local.json
.claude/metrics/

# Security-sensitive files
.npmrc
*.pem
*.key

# Local summon config
.summon

# Agent audit reports (public repo -- kept local, Rule #70)
docs/agents/
